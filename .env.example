# ------------------------------------------------------------------
# MineOps configuration (copy to .env and fill in real values).
# NEVER commit .env to Git.
# ------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram numeric user ID of the bot OWNER (private bot: only this user
# gets a reply in DM; the bot is never public). OWNER_ID is the canonical
# name, SUPER_ADMIN_ID is kept as a legacy alias.
OWNER_ID=

# Legacy alias for OWNER_ID (ignored if OWNER_ID is set).
SUPER_ADMIN_ID=

# Optional Fernet key for encrypting Aternos cookies (32-byte base64url).
# Leave empty to auto-generate and store in data/secret.key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (Go reads the same key: base64url of 32 random bytes)
ENCRYPTION_KEY=
