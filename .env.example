# ------------------------------------------------------------------
# MineOps configuration (copy to .env and fill in real values).
# NEVER commit .env to Git.
# ------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram numeric user ID of the SUPER ADMIN — gets error
# notifications, can use /announce. Other users self-onboard via /start.
# SUPER_ADMIN_ID is the canonical name, OWNER_ID is kept as a legacy alias.
SUPER_ADMIN_ID=

# Legacy alias for SUPER_ADMIN_ID (ignored if SUPER_ADMIN_ID is set).
OWNER_ID=

# Optional Fernet key for encrypting Aternos cookies (32-byte base64url).
# Leave empty to auto-generate and store in data/secret.key.
# Generate with: head -c 32 /dev/urandom | base64
ENCRYPTION_KEY=