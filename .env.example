# ------------------------------------------------------------------
# MineOps configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram numeric user ID of the owner (admin)
OWNER_ID=

# Group chat ID where the live pinned dashboard lives (e.g. -1001234567890).
# If empty, the dashboard is pinned in the owner's private chat instead.
# DASHBOARD_CHAT_ID=

# Aternos account credentials.
# ATERNOS_USERNAME can be EITHER your Aternos username OR the email used
# for the account.
ATERNOS_USERNAME=
ATERNOS_PASSWORD=
# Optional: prefer a saved ATERNOS_SESSION cookie over credentials
# ATERNOS_SESSION=

# Your Aternos server address (e.g. myworld.aternos.me) and port
SERVER_ADDRESS=
SERVER_PORT=25565

# Automated world backup interval in hours (also changeable at runtime
# with /setbackup or the "Backup Now" button)
DEFAULT_BACKUP_HOURS=24

# How often the pinned live dashboard is refreshed (seconds).
# Routine checks use the public mcsrvstat status API; the Aternos panel is
# only consulted when the server is offline/starting.
DASHBOARD_UPDATE_SECONDS=30

# Minimum interval (seconds) between Aternos panel scrapes. The live loop
# polls mcsrvstat every DASHBOARD_UPDATE_SECONDS and re-scrapes the Aternos
# panel at most once per PANEL_REFRESH_SECONDS - this keeps Cloudflare
# bypass retries (and panel latency) out of the status loop.
PANEL_REFRESH_SECONDS=120

# Minimum pause (seconds) after a failed Aternos login before the scraper is
# tried again. Prevents the polling loop from hammering Cloudflare while Aternos
# temporarily blocks the panel (e.g. wrong credentials or too many challenges).
AUTH_BACKOFF_SECONDS=600

# Startup notification to the owner (1 = yes)
STARTUP_NOTIFY=1

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# SQLite database path (volume-mounted in Docker)
# DB_PATH=data/bot_data.db