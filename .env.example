# ------------------------------------------------------------------
# MineOps configuration (copy to .env and fill in real values).
# NEVER commit .env to Git.
# ------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram numeric user ID of the super admin (bot owner, /announce etc.)
SUPER_ADMIN_ID=

# Optional Fernet key for encrypting Aternos cookies.
# Leave empty to auto-generate and store in data/secret.key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
